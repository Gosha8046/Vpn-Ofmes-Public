# -----------------------------------------------------------------------
# EXAMPLE OpenVPN client configuration.
#
# Placeholder template shipped with Vpn-Ofmes, not a working config.
# Replace `remote`, and the ca/cert/key material below (or point `ca`,
# `cert` and `key` to real files) with what your OpenVPN server or
# provider gives you. Vpn-Ofmes passes this file to the official
# openvpn.exe binary unmodified via --config, plus --auth-user-pass for
# the username/password entered on the Home screen.
# -----------------------------------------------------------------------

client
dev tun
proto udp
remote ovpn.example.com 1194
resolv-retry infinite
nobind
persist-key
persist-tun
remote-cert-tls server
cipher AES-256-GCM
auth SHA256
verb 3

<ca>
-----BEGIN CERTIFICATE-----
REPLACE_WITH_YOUR_CA_CERTIFICATE
-----END CERTIFICATE-----
</ca>
